FROM python:3.12-slim
RUN apt-get update -qq && apt-get install -y --no-install-recommends poppler-utils tesseract-ocr tesseract-ocr-rus && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir Pillow==11.1.0
WORKDIR /work
COPY tools/ocr_tickets.py /work/ocr_tickets.py
ENTRYPOINT ["python", "/work/ocr_tickets.py"]
